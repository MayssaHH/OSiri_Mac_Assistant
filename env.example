# OSiri Mac Assistant - Environment Variables
# Copy this file to .env and fill in your values
#
# cp env.example .env
# Then edit .env with your API keys

# ===========================================
# REQUIRED - OpenAI API Key
# ===========================================
OPENAI_API_KEY=sk-your-openai-api-key-here

# ===========================================
# OPTIONAL - Web Search (Tavily)
# ===========================================
# Get a free key at https://tavily.com/
# ⚠️  IMPORTANT: ProtonVPN (or similar) may be required for Tavily to work
#     in some regions. Connect to VPN before starting OSiri.
TAVILY_API_KEY=tvly-your-tavily-api-key-here

# ===========================================
# A2A Server URLs (for local development)
# These are pre-configured for Docker, only change if running locally
# ===========================================
# A2A_BASE_URL=http://127.0.0.1:9997/
# TERMINAL_AGENT_URL=http://127.0.0.1:9998/
# WEB_AGENT_URL=http://127.0.0.1:9999/
# APP_AGENT_URL=http://127.0.0.1:9996/

# ===========================================
# Slack Integration
# ===========================================
# Get your bot token from https://api.slack.com/apps
# Required OAuth scopes:
#   - chat:write (send messages)
#   - channels:read (list public channels)
#   - channels:history (read public channel messages)
#   - groups:read (list private channels)
#   - groups:history (read private channel messages)
# After adding scopes, reinstall the app to your workspace
# Then invite the bot to channels: /invite @YourBotName
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token

# ===========================================
# Gmail Integration
# ===========================================
# 1. Create a Google Cloud project and enable Gmail API
# 2. Download OAuth credentials as credentials.json
# 3. Place credentials.json in app/maf_agent/
# 4. Run: cd app && python test_gmail.py
#    This creates token.json for OAuth authentication
# 
# Files needed in app/maf_agent/:
#   - credentials.json (from Google Cloud Console)
#   - token.json (generated after running test_gmail.py)

